# Control Center — personal command center.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Claude — the brain behind Jarvis + the 40+ agents.
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-6

# Owner gate. Only this email can use the Control Center.
OWNER_EMAIL=you@example.com

# PIN entry — replaces the magic-link / password login. Owner types this on
# /enter to get in. Defaults to 08172009 when unset.
OWNER_CODE=08172009

# The actual Supabase password set on the OWNER_EMAIL user. /enter uses this
# server-side to translate the PIN into a real Supabase session under the
# hood, so RLS / data access keeps working as before.
OWNER_SUPABASE_PASSWORD=

# Optional voice-name match inside the app's auth challenge (separate from
# the PIN — the AuthChallenge component in /cc layout uses these). Leave
# blank to skip the in-app challenge entirely.
OWNER_NAME=

# Public origin — required for outbound calls (TwiML callbacks) and ad-platform
# OAuth callbacks. Should be the URL the desktop / browser actually hits.
PUBLIC_APP_ORIGIN=https://your-deployment.example.com

# Cron secret — set on Vercel cron to run the dispatcher tick + outbound drain.
# Header: x-cron-secret: <this value>
CRON_SECRET=

# Outbound channels (required for the autonomous call/text/email team).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Ad platform OAuth.
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
META_APP_ID=
META_APP_SECRET=
TIKTOK_APP_ID=
TIKTOK_APP_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# Owner phone — used for critical-alert phone calls via Twilio.
# E.164 format, e.g. +15551234567.
OWNER_PHONE=

# ContractorFlow integration — pulls leads from your other CF Supabase.
CONTRACTORFLOW_SUPABASE_URL=
CONTRACTORFLOW_SUPABASE_SERVICE_ROLE_KEY=

# Natural Jarvis voice (ElevenLabs). Without this, Jarvis falls back to the
# browser's robotic SpeechSynthesis voice. Sign up at elevenlabs.io, grab an
# API key, and (optionally) pick a voice ID from your voice library.
ELEVENLABS_API_KEY=
# Default voice is "Daniel" (onwK4e9ZLuTAKqWW03F9) — deep British, MCU Jarvis
# vibe. Pick a different voice ID from Voice Library to override.
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_turbo_v2_5

# Tavily web search (optional — Jarvis's web_search tool falls back to
# DuckDuckGo if this is missing).
TAVILY_API_KEY=

# Deepgram streaming STT (optional but huge for voice latency). Without
# this, Jarvis falls back to the browser's Web Speech API which is slow
# and Chrome-only. Sign up at console.deepgram.com — $200 free credit.
#   DEEPGRAM_API_KEY    — a project-level admin key (used to mint short-
#                          lived per-session tokens)
#   DEEPGRAM_PROJECT_ID — the project the API key belongs to
DEEPGRAM_API_KEY=
DEEPGRAM_PROJECT_ID=

# Google OAuth — lights up Gmail + Calendar integrations for Jarvis.
# Create credentials at https://console.cloud.google.com/apis/credentials
# (Web application, redirect URI = https://<your-domain>/api/google/callback).
# Enable APIs: Gmail API + Google Calendar API.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Comma-separated scopes; defaults below cover read + send email + read/write
# calendar.
GOOGLE_SCOPES=https://www.googleapis.com/auth/gmail.modify,https://www.googleapis.com/auth/calendar
